@name ptgamma/engines/EE_6KT
#ENGINE CONFIG
ENG_Version = "2.0.67"
#For use in ~350/400hp EE locomotives (Such as BR Classes 08, 09, 11, 12, 13, VR F Class, NS 500 and 600 Classes), also acceptable as a 6RKT substitute.
EngineType = "English Electric 6KT" #What is the name of the Prime Mover?

Startup_Hi = "kei/trains/engines/ee_6kt/startup.wav" #Startup Sound to put the engine in High (Normal) Idle.
Startup_Lo = "" #Startup Sound to put the engine in Low Idle.
Startup_Mode = 1 #0 for Low, 1 for High

Shutdown_Hi = "kei/trains/engines/ee_6kt/shutdown.wav" #Shutdown Sound from High Idle.
Shutdown_Lo = "" #Shutdown Sound from Low Idle.
Shutdown_Mode = 1 #0 for Low, 1 for High, 2 for Both as the situation demands it

FuelSaverMode = 0 #If set to 1, the locomotive will go into and out of Low Idle as the reverser is moved in and out of Neutral
FuelSaverDelay = 0 #Time, in seconds, for engine to fall into Low Idle, if used.

TransitionToLow = "" #Transition sound for High to Low idle, if used.
TransitionToHigh = "" #Transition sound for Low to High idle, if used.
Idle_Low = "" #Sound for Low Idle, if used.

NumEngineNotches = 4 #Number of Engine Notches, not counting idle.

Notches = array(
    "kei/trains/engines/ee_6kt/idle.wav",
